local function getIceRgb()
    return Color3.fromRGB(255, 255, 255):Lerp(Color3.fromRGB(0, 170, 255), (math.sin(tick() * 1.5) + 1) / 2)
end

local function getHealthColor(health, maxHealth)
    return Color3.fromRGB(255, 50, 50):Lerp(Color3.fromRGB(50, 255, 130), math.clamp(health / (maxHealth > 0 and maxHealth or 100), 0, 1))
end

local function getTargetPart(character)
    if not character then return nil end
    return AimTargetPart == "Head" and character:FindFirstChild("Head") or (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso"))
end

