local function createEspDrawings(player)
    if EspCache[player] then return EspCache[player] end
    local bo, b, t = Drawing.new("Square"), Drawing.new("Square"), Drawing.new("Line")
    bo.Thickness, bo.Color, bo.Filled, bo.Transparency = 3, Color3.fromRGB(0, 0, 0), false, 0.5
    b.Thickness, b.Filled, b.Transparency = 1.5, false, 0.65
    t.Thickness, t.Transparency = 1.5, 0.65

    local function makeTxt(sz, clr)
        local txt = Drawing.new("Text")
        txt.Size, txt.Center, txt.Outline, txt.OutlineColor = sz, true, true, Color3.fromRGB(0, 0, 0)
        if clr then txt.Color = clr end
        return txt
    end

    local drawings = {BoxOutline = bo, Box = b, Tracer = t, NameText = makeTxt(12), HpText = makeTxt(11), DistText = makeTxt(11, Color3.fromRGB(150, 220, 255))}
    EspCache[player] = drawings
    return drawings
end

local function getSmallEsp(player)
    if SmallEspCache[player] then return SmallEspCache[player] end
    local sq = Drawing.new("Square")
    sq.Thickness, sq.Filled, sq.Color, sq.Transparency = 1.5, true, Color3.fromRGB(255, 255, 255), 0.95
    SmallEspCache[player] = sq
    return sq
end

RunService.RenderStepped:Connect(function()
    local cam = getCamera()
    local iceRgb = getIceRgb()
    
    local centerScreen = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    FOVCircle.Position, FOVCircle.Visible, FOVCircle.Color = centerScreen, AimbotEnabled, iceRgb
    
    if CrosshairEnabled then
        CrosshairDot.Position, CrosshairDot.Color, CrosshairDot.Visible = centerScreen, iceRgb, true
    else
        CrosshairDot.Visible = false
    end

    MainStroke.Color, Title.TextColor3, OpenStroke.Color = iceRgb, iceRgb, iceRgb

    -- أنيميشن شعاع الرادار خلف زر الفتح الدائري
    if OpenButton.Visible then
        RadarPing.Visible = true
        RadarPing.Position = UDim2.new(OpenButton.Position.X.Scale, OpenButton.Position.X.Offset + 21, OpenButton.Position.Y.Scale, OpenButton.Position.Y.Offset + 21)
        local pulse = (tick() % 1.2) / 1.2
        RadarPing.Size = UDim2.new(0, 42 + (pulse * 25), 0, 42 + (pulse * 25))
        RadarPing.BackgroundTransparency = 0.3 + (pulse * 0.7)
    else
        RadarPing.Visible = false
    end

    local targetPlayer = AimbotEnabled and getClosestPlayer() or nil

    if targetPlayer and targetPlayer.Character then
        local part = getTargetPart(targetPlayer.Character)
        if part and (not WALL_CHECK or isVisible(part)) then
            local targetPos = part.Position + ((part.Velocity or Vector3.zero) * PREDICTION_FACTOR)
            local targetCFrame = CFrame.new(cam.CFrame.Position, targetPos)
            cam.CFrame = cam.CFrame:Lerp(targetCFrame, 0.45)
        end
    end

    for _, player in pairs(Players:GetPlayers()) do
        local isTeam = TEAM_CHECK and LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team
        
        -- Head ESP (مربع أبيض ناصع فوق الرأس)
        local smallSq = getSmallEsp(player)
        if SmallHeadEspEnabled and player ~= LocalPlayer and not isTeam and player.Character then
            local head = player.Character:FindFirstChild("Head")
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                local headPos, onScreen = cam:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (head.Position - cam.CFrame.Position).Magnitude
                    local size = math.clamp(140 / dist, 6, 14)
                    smallSq.Size = Vector2.new(size, size)
                    smallSq.Position = Vector2.new(headPos.X - size / 2, headPos.Y - size / 2)
                    smallSq.Visible = true
                else smallSq.Visible = false end
            else smallSq.Visible = false end
        else smallSq.Visible = false end

        -- Full ESP
        local drawings = createEspDrawings(player)
        if EspEnabled and player ~= LocalPlayer and not isTeam and player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
            local hum, hrp = player.Character:FindFirstChildOfClass("Humanoid"), player.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp then
                local hrpPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local head = player.Character:FindFirstChild("Head")
                    local headPos = head and cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or cam:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
                    local legPos = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                    local height = math.abs(headPos.Y - legPos.Y)
                    local width = height / 1.8

                    drawings.BoxOutline.Size, drawings.BoxOutline.Position, drawings.BoxOutline.Visible = Vector2.new(width, height), Vector2.new(hrpPos.X - width / 2, hrpPos.Y - height / 2), true
                    drawings.Box.Size, drawings.Box.Position, drawings.Box.Color, drawings.Box.Visible = Vector2.new(width, height), Vector2.new(hrpPos.X - width / 2, hrpPos.Y - height / 2), iceRgb, true
                    drawings.Tracer.From, drawings.Tracer.To, drawings.Tracer.Color, drawings.Tracer.Visible = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y), Vector2.new(hrpPos.X, hrpPos.Y + height / 2), iceRgb, true
                    
                    drawings.NameText.Text, drawings.NameText.Position, drawings.NameText.Color, drawings.NameText.Visible = player.Name, Vector2.new(hrpPos.X, hrpPos.Y - height / 2 - 16), Color3.fromRGB(255, 255, 255), true
                    drawings.HpText.Text, drawings.HpText.Position, drawings.HpText.Color, drawings.HpText.Visible = math.floor(hum.Health) .. " HP", Vector2.new(hrpPos.X, hrpPos.Y + height / 2 + 2), getHealthColor(hum.Health, hum.MaxHealth), true
                    drawings.DistText.Text, drawings.DistText.Position, drawings.DistText.Visible = math.floor((hrp.Position - cam.CFrame.Position).Magnitude) .. "m", Vector2.new(hrpPos.X, hrpPos.Y + height / 2 + 15), true
                else
                    drawings.Box.Visible, drawings.BoxOutline.Visible, drawings.Tracer.Visible, drawings.NameText.Visible, drawings.HpText.Visible, drawings.DistText.Visible = false, false, false, false, false, false
                end
            else
                drawings.Box.Visible, drawings.BoxOutline.Visible, drawings.Tracer.Visible, drawings.NameText.Visible, drawings.HpText.Visible, drawings.DistText.Visible = false, false, false, false, false, false
            end
        else
            drawings.Box.Visible, drawings.BoxOutline.Visible, drawings.Tracer.Visible, drawings.NameText.Visible, drawings.HpText.Visible, drawings.DistText.Visible = false, false, false, false, false, false
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if EspCache[player] then
        for _, drawing in pairs(EspCache[player]) do drawing:Remove() end
        EspCache[player] = nil
    end
    if SmallEspCache[player] then
        SmallEspCache[player]:Remove()
        SmallEspCache[player] = nil
    end
end)
                                     
