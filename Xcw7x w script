local draggingFov = false
local function updateFovSlider(input)
    local posX = math.clamp(input.Position.X - FovSliderFrame.AbsolutePosition.X, 0, FovSliderFrame.AbsoluteSize.X)
    local percentage = posX / FovSliderFrame.AbsoluteSize.X
    FOV_RADIUS = math.floor(20 + (500 - 20) * percentage)
    FovSliderBtn.Position, FovLabel.Text, FOVCircle.Radius = UDim2.new(percentage, -5, 0.5, -5), "FOV: " .. tostring(FOV_RADIUS), FOV_RADIUS
end

