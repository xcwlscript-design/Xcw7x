-- نظام جلب وتحديث المتصلين بدون أي أخطاء (pcall)
local function refreshOnlineCount()
    task.spawn(function()
        local count = 1
        local success, response = pcall(function()
            return game:HttpGet("https://api.counterapi.dev/v1/xcw7x_script/online_users/up")
        end)
        
        if success and response then
            pcall(function()
                local data = HttpService:JSONDecode(response)
                if data and data.count then
                    count = data.count
                end
            end)
        end
        
        OnlineText.Text = "المتصلين بالسكريبت: " .. tostring(count) .. " 👤"
    end)
end

