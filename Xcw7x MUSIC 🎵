local function playAudio(id)
    local cleanId = string.match(tostring(id), "%d+")
    if cleanId then
        Music:Stop()
        Music.TimePosition = 0
        Music.SoundId = "rbxassetid://" .. cleanId
        Music.Volume = 1.5 * powerMultiplier
        Music:Play()
        
        StopBtn.Text = "⬛ إيقاف الأغنية"
        StatusLabel.Text = "جاري تشغيل: " .. cleanId
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
    else
        StatusLabel.Text = "الكود غير صحيح!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
    end
end

