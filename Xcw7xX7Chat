-- 🔔 Animated Notifications
local function ShowNotification(playerOrName, text)
    if not playerOrName then return end

    local currentNotifs = NotifContainer:GetChildren()
    if #currentNotifs > 3 then
        for _, v in ipairs(currentNotifs) do
            if v:IsA("CanvasGroup") or v:IsA("Frame") then
                v:Destroy()
                break
            end
        end
    end

    local notif = Instance.new("CanvasGroup", NotifContainer)
    notif.Size = UDim2.new(1, 0, 0, 0)
    notif.GroupTransparency = 1
    notif.BackgroundColor3 = Color3.fromRGB(12, 16, 24)

    Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 8)

    local isDev = IsDev(playerOrName)
    local stroke = Instance.new("UIStroke", notif)
    stroke.Thickness = 1.2
    stroke.Color = isDev and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(0, 170, 255)

    local avatar = Instance.new("ImageLabel", notif)
    avatar.Size = UDim2.new(0, 34, 0, 34)
    avatar.Position = UDim2.new(0, 7, 0.5, -17)
    avatar.BackgroundTransparency = 1
    Instance.new("UICorner", avatar).CornerRadius = UDim.new(1, 0)

    local senderName = type(playerOrName) == "string" and playerOrName or playerOrName.Name
    local userId = typeof(playerOrName) == "Instance" and playerOrName:IsA("Player") and playerOrName.UserId or nil

    if userId then
        task.spawn(function()
            pcall(function()
                local content = Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
                avatar.Image = content
            end)
        end)
    end

    local nameLbl = Instance.new("TextLabel", notif)
    nameLbl.Size = UDim2.new(1, -50, 0, 16)
    nameLbl.Position = UDim2.new(0, 48, 0, 5)
    nameLbl.BackgroundTransparency = 1
    nameLbl.RichText = true
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 11
    nameLbl.TextXAlignment = Enum.TextXAlignment.Left

    if isDev then
        nameLbl.Text = '<font color="#FFD700">👑 [DEV]</font> <font color="#FFFFFF">' .. senderName .. '</font>'
    else
        nameLbl.Text = '<font color="#00AAFF">' .. senderName .. '</font>'
    end

    local msgLbl = Instance.new("TextLabel", notif)
    msgLbl.Size = UDim2.new(1, -50, 0, 18)
    msgLbl.Position = UDim2.new(0, 48, 0, 22)
    msgLbl.BackgroundTransparency = 1
    msgLbl.Font = Enum.Font.Gotham
    msgLbl.TextSize = 11
    msgLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    msgLbl.TextXAlignment = Enum.TextXAlignment.Left
    msgLbl.TextTruncate = Enum.TextTruncate.AtEnd
    msgLbl.Text = text

    TS:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(1, 0, 0, 48),
        GroupTransparency = 0.15
    }):Play()

    task.delay(3.5, function()
        if notif and notif.Parent then
            local fade = TS:Create(notif, TweenInfo.new(0.4), {
                Size = UDim2.new(1, 0, 0, 0),
                GroupTransparency = 1
            })
            fade:Play()
            fade.Completed:Connect(function() notif:Destroy() end)
        end
    end)
end

-- 👑 Overhead Chat Bubbles
local function CreateHeadBubble(player, text)
    if not player or not player.Character then return end
    local head = player.Character:FindFirstChild("Head")
    if not head then return end

    local old = head:FindFirstChild("X7Bubble")
    if old then old:Destroy() end

    local isDev = IsDev(player)
    local bb = Instance.new("BillboardGui", head)
    bb.Name = "X7Bubble"
    bb.Adornee = head
    bb.Size = UDim2.new(0, 200, 0, 36)
    bb.StudsOffset = Vector3.new(0, 2.5, 0)
    bb.AlwaysOnTop = true

    local lbl = Instance.new("TextLabel", bb)
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundColor3 = Color3.fromRGB(12, 16, 24)
    lbl.BackgroundTransparency = 0.2
    lbl.RichText = true
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 12
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.TextWrapped = true

    if isDev then
        lbl.Text = '<font color="#FFD700">👑 [DEV]</font> <font color="#FFFFFF">' .. player.Name .. ': ' .. text .. '</font>'
    else
        lbl.Text = '<font color="#00AAFF">[PLAYER]</font> <font color="#FFFFFF">' .. player.Name .. ': ' .. text .. '</font>'
    end

    Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", lbl)
    stroke.Thickness = 1.2
    stroke.Color = Color3.fromRGB(0, 0, 0)

    task.delay(3.6, function()
        if bb and bb.Parent then
            TS:Create(lbl, TweenInfo.new(0.4), {TextTransparency = 1, BackgroundTransparency = 1}):Play()
            TS:Create(stroke, TweenInfo.new(0.4), {Transparency = 1}):Play()
            task.wait(0.4)
            if bb and bb.Parent then bb:Destroy() end
        end
    end)
end

-- Add Chat Messages To Scroll View
local function AddMessage(sender, msg, isDev, isGlobal)
    local Lbl = Instance.new("TextLabel", Scroll)
    Lbl.Size = UDim2.new(1, 0, 0, 0)
    Lbl.AutomaticSize = Enum.AutomaticSize.Y
    Lbl.BackgroundTransparency = 1
    Lbl.RichText = true
    Lbl.Font = Enum.Font.GothamBold
    Lbl.TextSize = 12
    Lbl.TextXAlignment = Enum.TextXAlignment.Left
    Lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    Lbl.TextWrapped = true

    Lbl:SetAttribute("IsGlobal", isGlobal)
    Lbl.Visible = (isGlobal == isGlobalActive)

    local tag = isGlobal and '<font color="#A855F7">[GLOBAL]</font> ' or ''
    if isDev then
        Lbl.Text = tag .. '<font color="#FFD700">👑 [DEV]</font> <font color="#FFFFFF">' .. sender .. ': ' .. msg .. '</font>'
    else
        Lbl.Text = tag .. '<font color="#00AAFF">[PLAYER]</font> <font color="#FFFFFF">' .. sender .. ': ' .. msg .. '</font>'
    end
end

-- Send Message Logic
InputBox.FocusLost:Connect(function(enter)
    if enter and InputBox.Text:gsub("%s+", "") ~= "" then
        local msg = InputBox.Text
        InputBox.Text = ""

        if isGlobalActive then
            AddMessage(LP.Name, msg, IsDev(LP), true)

            if httpRequest then
                task.spawn(function()
                    pcall(function()
                        httpRequest({
                            Url = GLOBAL_API_URL .. "/send",
                            Method = "POST",
                            Headers = {["Content-Type"] = "application/json"},
                            Body = HttpService:JSONEncode({
                                sender = LP.Name,
                                message = msg,
                                isDev = IsDev(LP),
                                userId = LP.UserId
                            })
                        })
                    end)
                end)
            end
        else
            AddMessage(LP.Name, msg, IsDev(LP), false)
            CreateHeadBubble(LP, msg)
            ShowNotification(LP, msg)

            pcall(function()
                if TCS.ChatVersion == Enum.ChatVersion.TextChatService then
                    local channel = TCS.TextChannels:FindFirstChild("RBXGeneral")
                    if channel then channel:SendAsync(msg) end
                else
                    RS.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(msg, "All")
                end
            end)
        end
    end
end)

-- Player Connections
local function ConnectPlayer(p)
    if p == LP then return end
    p.Chatted:Connect(function(msg)
        UpdateUserCounter()
        AddMessage(p.Name, msg, IsDev(p), false)
        CreateHeadBubble(p, msg)
        ShowNotification(p, msg)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do ConnectPlayer(p) end
Players.PlayerAdded:Connect(function(p)
    ConnectPlayer(p)
    UpdateUserCounter()
end)

Players.PlayerRemoving:Connect(function(p)
    UpdateUserCounter()
end)

-- 🔄 Polling for Global Chat
task.spawn(function()
    while task.wait(2) do
        if httpRequest then
            pcall(function()
                local res = httpRequest({
                    Url = GLOBAL_API_URL .. "/messages",
                    Method = "GET"
                })
                if res and res.Body then
                    local data = HttpService:JSONDecode(res.Body)
                    if data and type(data) == "table" then
                        for _, item in ipairs(data) do
                            if item.id and not receivedGlobalMsgIds[item.id] then
                                receivedGlobalMsgIds[item.id] = true
                                if item.userId ~= LP.UserId then
                                    AddMessage(item.sender, item.message, item.isDev, true)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)
