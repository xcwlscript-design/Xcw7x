-- 👑 Developer Check (XCW7H)
local function IsDev(p) 
    if typeof(p) == "Instance" and p:IsA("Player") then
        return p.Name:upper() == "XCW7H"
    elseif type(p) == "string" then
        return p:upper() == "XCW7H"
    end
    return false
end

