-- 🔄 Update Counter Label
local function UpdateUserCounter()
    local localUsersCount = #Players:GetPlayers()
    UserCounter.Text = "🟢 Server: " .. localUsersCount .. " | 🌐 Script Online: " .. globalOnlineUsersCount
end

-- 💓 Heartbeat System
task.spawn(function()
    while true do
        if httpRequest then
            pcall(function()
                local res = httpRequest({
                    Url = GLOBAL_API_URL .. "/heartbeat",
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode({
                        userId = LP.UserId,
                        username = LP.Name
                    })
                })
                if res and res.Body then
                    local parsedData = HttpService:JSONDecode(res.Body)
                    if parsedData and parsedData.onlineCount then
                        globalOnlineUsersCount = parsedData.onlineCount
                        UpdateUserCounter()
                    end
                end
            end)
        end
        task.wait(15)
    end
end)

