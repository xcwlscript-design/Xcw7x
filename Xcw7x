-- 👥 User Tracking Logic
local activeUsers = {}
local function UpdateUserCounter()
    local count = 0
    for _ in pairs(activeUsers) do count = count + 1 end
    if count == 0 then count = 1 end
    UserCounter.Text = "🟢 Active Users: " .. count .. " / " .. #Players:GetPlayers()
end

activeUsers[LP.UserId] = true
UpdateUserCounter()

-- 🔔 Animated Notifications
local function ShowNotification(player, text)
    if not player then return end

    local currentNotifs = NotifContainer:GetChildren()
    if #currentNotifs > 3 then
        for _, v in ipairs(currentNotifs) do
            if v:IsA("CanvasGroup") or v:IsA("Frame") then
                v:Destroy()
                break
            end
        end
    end

    local notif = Instance.new("CanvasGroup", NotifContainer)
    notif.Size = UDim2.new(1, 0, 0, 0)
    notif.GroupTransparency = 1
    notif.BackgroundColor3 = Color3.fromRGB(12, 16, 24)

    Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 8)

    local isDev = IsDev(player)
    local stroke = Instance.new("UIStroke", notif)
    stroke.Thickness = 1.2
    stroke.Color = isDev and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(0, 170, 255)

    local avatar = Instance.new("ImageLabel", notif)
    avatar.Size = UDim2.new(0, 34, 0, 34)
    avatar.Position = UDim2.new(0, 7, 0.5, -17)
    avatar.BackgroundTransparency = 1
    Instance.new("UICorner", avatar).CornerRadius = UDim.new(1, 0)

    task.spawn(function()
        pcall(function()
            local content = Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
            avatar.Image = content
        end)
    end)

    local nameLbl = Instance.new("TextLabel", notif)
    nameLbl.Size = UDim2.new(1, -50, 0, 16)
    nameLbl.Position = UDim2.new(0, 48, 0, 5)
    nameLbl.BackgroundTransparency = 1
    nameLbl.RichText = true
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 11
    nameLbl.TextXAlignment = Enum.TextXAlignment.Left

    if isDev then
        nameLbl.Text = '<font color="#FFD700">👑 [DEV]</font> <font color="#FFFFFF">' .. player.Name .. '</font>'
    else
        nameLbl.Text = '<font color="#00AAFF">' .. player.Name .. '</font>'
    end

    local msgLbl = Instance.new("TextLabel", notif)
    msgLbl.Size = UDim2.new(1, -50, 0, 18)
    msgLbl.Position = UDim2.new(0, 48, 0, 22)
    msgLbl.BackgroundTransparency = 1
    msgLbl.Font = Enum.Font.Gotham
    msgLbl.TextSize = 11
    msgLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    msgLbl.TextXAlignment = Enum.TextXAlignment.Left
    msgLbl.TextTruncate = Enum.TextTruncate.AtEnd
    msgLbl.Text = text

    TS:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(1, 0, 0, 48),
        GroupTransparency = 0.15
    }):Play()

    task.delay(3.5, function()
        if notif and notif.Parent then
            local fade = TS:Create(notif, TweenInfo.new(0.4), {
                Size = UDim2.new(1, 0, 0, 0),
                GroupTransparency = 1
            })
            fade:Play()
            fade.Completed:Connect(function() notif:Destroy() end)
        end
    end)
end

-- 👑 Overhead Chat Bubbles
local function CreateHeadBubble(player, text)
    if not player or not player.Character then return end
    local head = player.Character:FindFirstChild("Head")
    if not head then return end

    local old = head:FindFirstChild("Xcw7xBubble")
    if old then old:Destroy() end

    local isDev = IsDev(player)
    local bb = Instance.new("BillboardGui", head)
    bb.Name = "Xcw7xBubble"
    bb.Adornee = head
    bb.Size = UDim2.new(0, 200, 0, 36)
    bb.StudsOffset = Vector3.new(0, 2.5, 0)
    bb.AlwaysOnTop = true

    local lbl = Instance.new("TextLabel", bb)
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundColor3 = Color3.fromRGB(12, 16, 24)
    lbl.BackgroundTransparency = 0.2
    lbl.RichText = true
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 12
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.TextWrapped = true

    if isDev then
        lbl.Text = '<font color="#FFD700">👑 [DEV]</font> <font color="#FFFFFF">' .. player.Name .. ': ' .. text .. '</font>'
    else
        lbl.Text = '<font color="#00AAFF">[PLAYER]</font> <font color="#FFFFFF">' .. player.Name .. ': ' .. text .. '</font>'
    end

    Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", lbl)
    stroke.Thickness = 1.2
    stroke.Color = Color3.fromRGB(0, 0, 0)

    task.delay(3.6, function()
        if bb and bb.Parent then
            TS:Create(lbl, TweenInfo.new(0.4), {TextTransparency = 1, BackgroundTransparency = 1}):Play()
            TS:Create(stroke, TweenInfo.new(0.4), {Transparency = 1}):Play()
            task.wait(0.4)
            if bb and bb.Parent then bb:Destroy() end
        end
    end)
end

