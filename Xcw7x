-- ✨ Button Hover Effects
local function AddHoverEffect(btn)
    local origSize = btn.Size
    btn.MouseEnter:Connect(function()
        TS:Create(btn, TweenInfo.new(0.15), {Size = UDim2.new(origSize.X.Scale, origSize.X.Offset + 3, origSize.Y.Scale, origSize.Y.Offset + 3)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TS:Create(btn, TweenInfo.new(0.15), {Size = origSize}):Play()
    end)
end

