-- 🚀 Server Hop to Highest Player Count
local function HopToBiggestServer()
    HopBtn.Text = "Wait"
    task.spawn(function()
        pcall(function()
            local apiUrl = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
            local raw = game:HttpGet(apiUrl)
            local data = HttpService:JSONDecode(raw)

            if data and data.data then
                for _, s in ipairs(data.data) do
                    if s.id ~= game.JobId and s.playing < s.maxPlayers then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LP)
                        return
                    end
                end
            end
        end)
        HopBtn.Text = "Hop"
    end)
end

HopBtn.MouseButton1Click:Connect(HopToBiggestServer)

