    else
        Lbl.Text = '<font color="#00AAFF">[PLAYER]</font> <font color="#FFFFFF">' .. sender .. ': ' .. msg .. '</font>'
    end
end

-- Send Message Logic
InputBox.FocusLost:Connect(function(enter)
    if enter and InputBox.Text:gsub("%s+", "") ~= "" then
        local msg = InputBox.Text
        InputBox.Text = ""

        AddMessage(LP.Name, msg, IsDev(LP))
        CreateHeadBubble(LP, msg)
        ShowNotification(LP, msg)

        pcall(function()
            if TCS.ChatVersion == Enum.ChatVersion.TextChatService then
                local channel = TCS.TextChannels:FindFirstChild("RBXGeneral")
                if channel then channel:SendAsync(msg) end
            else
                RS.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(msg, "All")
            end
        end)
    end
end)

-- Player Connections
local function ConnectPlayer(p)
    if p == LP then return end
    p.Chatted:Connect(function(msg)
        activeUsers[p.UserId] = true
        UpdateUserCounter()

        AddMessage(p.Name, msg, IsDev(p))
        CreateHeadBubble(p, msg)
        ShowNotification(p, msg)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do ConnectPlayer(p) end
Players.PlayerAdded:Connect(function(p)
    ConnectPlayer(p)
    UpdateUserCounter()
end)

Players.PlayerRemoving:Connect(function(p)
    activeUsers[p.UserId] = nil
    UpdateUserCounter()
end)
