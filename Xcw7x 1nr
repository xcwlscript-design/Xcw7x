-- 🎵 10. محرك صوت البومبوكس 3D
-- ============================================
local function Play3DSoundForPlayer(targetPlayer, soundId)
    if not targetPlayer or not targetPlayer.Character then return end
    local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart") or targetPlayer.Character:FindFirstChild("Head")
    if not hrp then return end

    local oldSound = hrp:FindFirstChild("Xcw7x3DSound")
    if oldSound then oldSound:Destroy() end

    if not soundId or soundId == "" or soundId == "STOP" then return end

    local sound = Instance.new("Sound")
    sound.Name = "Xcw7x3DSound"
    sound.SoundId = "rbxassetid://" .. soundId
    sound.Volume = 2.5
    sound.RollOffMinDistance = 10
    sound.RollOffMaxDistance = 60
    sound.RollOffMode = Enum.RollOffMode.Linear
    sound.Looped = true
    sound.Parent = hrp
    sound:Play()
end

local function BroadcastAudioSignal(soundId)
    Play3DSoundForPlayer(LocalPlayer, soundId)
    local payload = "[Xcw7xAudio:" .. soundId .. "]"
    
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if channel then channel:SendAsync(payload) end
        else
            local events = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            local sayMsg = events and events:FindFirstChild("SayMessageRequest")
            if sayMsg then sayMsg:FireServer(payload, "All") end
        end
    end)
end

local function ListenToPlayerAudio(player)
    player.Chatted:Connect(function(msg)
        local soundId = msg:match("^%[Xcw7xAudio:(%d+)%]$")
        if soundId then
            Play3DSoundForPlayer(player, soundId)
        elseif msg == "[Xcw7xAudio:STOP]" then
            Play3DSoundForPlayer(player, "STOP")
        end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    ListenToPlayerAudio(p)
end
Players.PlayerAdded:Connect(ListenToPlayerAudio)

PlayAudioBtn.MouseButton1Click:Connect(function()
    local id = BoomboxInput.Text:match("%d+")
    if id then BroadcastAudioSignal(id) end
end)

StopAudioBtn.MouseButton1Click:Connect(function()
