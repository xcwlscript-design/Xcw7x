-- Helper: Get Player Avatar Image
local function GetAvatar(playerOrName)
    local userId = typeof(playerOrName) == "Instance" and playerOrName:IsA("Player") and playerOrName.UserId or nil
    if not userId and type(playerOrName) == "string" then
        local p = Players:FindFirstChild(playerOrName)
        if p then userId = p.UserId end
    end
    
    if userId then
        local content = "rbxassetid://0"
        pcall(function()
            content = Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
        end)
        return content
    end
    return "rbxassetid://0"
end

