-- 💓 Global Heartbeat System
task.spawn(function()
    while true do
        if httpRequest then
            pcall(function()
                local res = httpRequest({
                    Url = GLOBAL_API_URL .. "/heartbeat",
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode({
                        userId = LP.UserId,
                        username = LP.Name
                    })
                })
                if res and res.Body then
                    local data = HttpService:JSONDecode(res.Body)
                    if data and data.onlineCount then
                        globalOnlineCount = data.onlineCount
                        UpdateUserCounter()
                    end
                end
            end)
        end
        task.wait(12)
    end
end)

