-- ⚡ Immediate Local Display & Server Broadcast logic
InputBox.FocusLost:Connect(function(enter)
    if enter and InputBox.Text:gsub("%s+", "") ~= "" then
        local msg = InputBox.Text
        InputBox.Text = ""

        -- 1. Display Local Player's message immediately on screen!
        AddMessageCard(LP, msg)
        ShowNotification(LP, msg)
        CreateHeadBubble(LP, msg)

        -- 2. Broadcast to server for other script users to receive
        pcall(function()
            if TCS.ChatVersion == Enum.ChatVersion.TextChatService then
                local channel = TCS.TextChannels:FindFirstChild("RBXGeneral")
                if channel then channel:SendAsync("[X7]: " .. msg) end
            else
                RS.DefaultChatSystemChatEvents.SayMessageRequest:FireServer("[X7]: " .. msg, "All")
            end
        end)
    end
end)

-- Process incoming messages from other players
local function ProcessIncomingMsg(sender, text)
    if not sender or sender == LP then return end -- Ignore LP as LP is already shown locally

    local cleanMsg = text
    local isX7 = false

    if text:sub(1, 6) == "[X7]: " then
        cleanMsg = text:sub(7)
        isX7 = true
        scriptUsers[sender.Name] = true
        UpdateUserCounter()
    elseif text:find("%[X7%]") then
        cleanMsg = text:gsub("%[X7%]:%s*", ""):gsub("%[X7%]", "")
        isX7 = true
        scriptUsers[sender.Name] = true
        UpdateUserCounter()
    end

    if isX7 or scriptUsers[sender.Name] then
        AddMessageCard(sender, cleanMsg)
        ShowNotification(sender, cleanMsg)
        CreateHeadBubble(sender, cleanMsg)
    end
end

-- Connect Legacy Chatted Event
local function ConnectPlayer(p)
    p.Chatted:Connect(function(msg)
        ProcessIncomingMsg(p, msg)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do ConnectPlayer(p) end
Players.PlayerAdded:Connect(function(p)
    ConnectPlayer(p)
    UpdateUserCounter()
end)

Players.PlayerRemoving:Connect(function(p)
    scriptUsers[p.Name] = nil
    UpdateUserCounter()
end)

-- Connect Modern TextChatService Event
pcall(function()
    if TCS.ChatVersion == Enum.ChatVersion.TextChatService then
        TCS.MessageReceived:Connect(function(textChatMessage)
            if textChatMessage.TextSource then
                local sender = Players:GetPlayerByUserId(textChatMessage.TextSource.UserId)
                if sender then
                    ProcessIncomingMsg(sender, textChatMessage.Text)
                end
            end
        end)
    end
end)

